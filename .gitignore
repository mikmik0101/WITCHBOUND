# --- Local secrets — never commit -----------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
secrets.json
credentials.json
appsettings.local.json

# --- This project: non-source / presentation material ---------------
# Compiled standalone builds (large, regenerable via BuildGame)
/Builds/
/Builds_backup_*/
# Presentation video project, exports, footage, narration
/VideoPresentation/
/Audio/
# Historical source snapshots kept locally
/Backups/

# --- Build outputs --------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app
